# Supabase Public Configuration (Exposed to browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase Server-side Configuration (Never exposed to client)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Application URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google Gemini AI Configuration (Server-side only)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.5-flash

# Multi-channel Notification Engine (Twilio WhatsApp)
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886
# WHATSAPP_TEST_TO=+91XXXXXXXXXX
# TWILIO_CONTENT_SID=

# Email Dispatcher (Nodemailer / Gmail SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-gmail-app-password
SMTP_FROM_EMAIL=your-email@gmail.com
